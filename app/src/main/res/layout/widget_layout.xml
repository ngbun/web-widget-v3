<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="HTML side" />

    <!-- Separate border layers: only visibility is controlled via RemoteViews. -->
    <ImageView
        android:id="@+id/widget_outline_rounded"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_outline_rounded"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/widget_outline_square"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_outline_square"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_refresh"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:gravity="center"
        android:background="@drawable/widget_button_round"
        android:text="↻"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:visibility="visible" />

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="6dp"
        android:paddingLeft="7dp"
        android:paddingTop="3dp"
        android:paddingRight="7dp"
        android:paddingBottom="3dp"
        android:background="#B3000000"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:maxLines="1"
        android:visibility="gone" />

</FrameLayout>
